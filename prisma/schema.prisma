// مدل دیتابیس پلتفرم برنامه‌ریزی مطالعاتی کنکور
// همه‌ی مدل‌ها اینجا تعریف می‌شوند تا Prisma Client بتواند با آن‌ها کار کند.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- نقش‌ها و وضعیت‌های کاربر ---
enum UserRole {
  STUDENT
  ADVISOR
  SUPERADMIN
  INSTITUTE_MANAGER // مدیر مؤسسه — فقط داده‌های مؤسسه‌ی خودش را می‌بیند (خواندنی + تأیید اعضا)
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED // توسط سوپرادمین غیرفعال شده — قابل بازگشت به ACTIVE
}

// --- رشته‌ی تحصیلی (برای فیلتر مشاور ↔ دانش‌آموز) ---
enum Field {
  HUMANITIES // علوم انسانی
  MATH_PHYSICS // ریاضی و فیزیک
  EXPERIMENTAL // علوم تجربی
}

// --- وضعیت اتصال مشاور ↔ دانش‌آموز ---
// دانش‌آموز ثبت‌نام می‌کند → link با PENDING ساخته می‌شود → مشاور ACCEPT یا REJECT می‌کند
// تا زمانی که link فعال نشود، مشاور نمی‌تواند برای دانش‌آموز برنامه/آزمون/یادآور بسازد
enum AdvisorLinkStatus {
  PENDING
  ACTIVE
  REJECTED
}

// مؤسسه‌ی آموزشی (آزمون‌ساز کنکور/آموزشگاه)
// اعضا (مشاور/دانش‌آموز/مدیر) با instituteId روی User به آن وصل می‌شوند.
// invariant مهم: null یعنی مستقل؛ لینک مشاور–دانش‌آموز هرگز از مرز مؤسسه عبور نمی‌کند
// (هر دو طرف عضو یک مؤسسه، یا هر دو null — در کنترلرهای ساخت لینک اعمال می‌شود).
model Institute {
  id        String     @id @default(cuid())
  name      String
  // کد دعوت یکتا — ثبت‌نام با این کد عضویت در مؤسسه می‌دهد و درخواست تأیید
  // به مدیر مؤسسه می‌رود (به‌جای سوپرادمین)
  code      String     @unique
  // مؤسسه هم مثل مشاور توسط سوپرادمین تأیید می‌شود
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  members      User[]
  subscription InstituteSubscription?
  // تنظیمات کارت واریز مؤسسه و رسیدهای مقصدِ مؤسسه در جدول‌های CardSettings و
  // DepositRequest با ownerKind='INSTITUTE' / targetKind='INSTITUTE' نگهداری می‌شوند
  // (رابطه‌ی polymorphic در Prisma با FK معمولی ممکن نیست؛ ownerId/targetId رشته‌ی ساده‌اند)
  // سردبیر/نماینده‌ی مؤسسه — یک عضو مؤسسه (معمولاً مشاور) که سوپرادمین تعیین می‌کند و
  // اختیارات مدیر مؤسسه را دارد: تأیید/رد اعضا، دیدن دانش‌آموزان و حذف عضو از مؤسسه.
  // role کاربر تغییر نمی‌کند؛ فقط همین اشاره‌گر اختیارات می‌دهد (middleware چک می‌کند).
  leaderId     String?
  leader       User?                  @relation("InstituteLeader", fields: [leaderId], references: [id], onDelete: SetNull)
}

// پیوند اشتراک ماهانه‌ی مؤسسه — خود مؤسسه پرداخت می‌کند، نه اعضا
model InstituteSubscription {
  id             String   @id @default(cuid())
  // یک‌به‌یک: هر مؤسسه در هر لحظه یک اشتراک جاری دارد (تاریخچه در paymentEvents)
  instituteId    String   @unique
  tier           String   @default("STANDARD")
  status         String   @default("TRIAL") // TRIAL | ACTIVE | GRACE | EXPIRED
  startsAt       DateTime @default(now())
  endsAt         DateTime
  // --- سقف اعضا (پلن‌بندی) — null یعنی بی‌نهایت ---
  // وقتی تعداد مشاور/دانش‌آموز مؤسسه از سقف بگذرد:
  //   - ثبت‌نام جدید با کد مؤسسه رد می‌شود
  //   - تأیید عضو در انتظار توسط مدیر رد می‌شود
  //   - تخصیص مشاور به مؤسسه توسط سوپرادمین رد می‌شود
  // با پیام «ظرفیت تکمیل است؛ اشتراک را ارتقا دهید»
  maxAdvisors    Int?
  maxStudents    Int?
  // ردپای پرداخت/تمدید دستی (درگاه بانکی + ویرایش سوپرادمین)
  lastPaymentRef String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
}

// اشتراک فردی مشاور یا دانش‌آموز — مثل InstituteSubscription اما یک‌به‌یک با User.
// کاربر می‌تواند هم عضو مؤسسه باشد (اشتراک مؤسسه‌اش فعال) و هم اشتراک فردی داشته باشد؛
// دسترسی مؤثر = اشتراک مؤسسه فعال «یا» اشتراک فردی فعال (منطق در utils/subscription.js).
// سوپرادمین با updateUserSubscription تنظیمش می‌کند و تأیید رسید واریز تمدیدش می‌کند.
// برای دانش‌آموزِ تازه ثبت‌نام، ۱۴ روز TRIAL خودکار ساخته می‌شود (سیاست پیش‌فرض).
model UserSubscription {
  id             String   @id @default(cuid())
  userId         String   @unique
  tier           String   @default("STANDARD")
  status         String   @default("TRIAL") // TRIAL | ACTIVE | GRACE | EXPIRED
  startsAt       DateTime @default(now())
  endsAt         DateTime
  lastPaymentRef String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// تنظیمات پرداخت یک هویت (کاربر یا مؤسسه) — شماره کارتی که دیگران برای تمدید
// اشتراکش به آن واریز می‌کنند. به‌جای دو جدول، ownerKind صاحب را مشخص می‌کند:
//   USER     → cardNumber متعلق به این کاربر است (مشاور مستقل)
//   INSTITUTE→ متعلق به مؤسسه است (دانش‌آموزان و مشاوران مؤسسه به آن واریز می‌کنند)
//   SYSTEM   → کارت پلتفرم (سوپرادمین آن را ست می‌کند؛ مشاورها و مؤسسه‌ها به آن واریز می‌کنند)
// کارتِ هر صاحب در getDepositContext به مراجع درست نمایش داده می‌شود.
// shaba اختیاری است برای نمایش «شماره شبا» کنار شماره کارت.
model CardSettings {
  id         String   @id @default(cuid())
  ownerKind  String // USER | INSTITUTE | SYSTEM
  ownerId    String? // userId یا instituteId؛ برای SYSTEM null (رابطه‌ی polymorphic — بدون FK)
  cardNumber String
  shaba      String?
  holderName String? // نام صاحب کارت (پیش‌فرض: نام کاربر/مؤسسه)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ownerKind, ownerId])
  @@index([ownerId])
}

// وضعیت یک رسید واریز — باز و بسته شدن چرخه‌ی پرداخت
enum DepositStatus {
  PENDING // ثبت شده، منتظر تأیید گیرنده
  APPROVED // تأیید شده و اشتراک مقصد تمدید شده
  REJECTED // رد شده (مبلغ/رسید نادرست و ...) — دوباره می‌تواند ثبت کند
}

// مقصد یک تمدید: چه کسی/چه چیزی اشتراکش تمدید می‌شود
// (USER → کاربرِ فردی؛ INSTITUTE → کل مؤسسه)
enum DepositTargetKind {
  USER
  INSTITUTE
}

// رسید واریز: پرداخت‌کننده عکس رسید را می‌فرستد، صاحب کارت (مشاور/مدیر مؤسسه/سوپرادمین)
// آن را می‌بیند و با تعیین دستی مدت (روز) تأیید می‌کند؛ در همان لحظه
// اشتراک مقصد از max(الان، پایان فعلی) به اندازه‌ی همان روزها تمدید می‌شود.
model DepositRequest {
  id              String            @id @default(cuid())
  // پرداخت‌کننده — هر کاربر لاگین‌شده‌ای می‌تواند رسید بفرستد
  payerId         String
  payer           User              @relation("DepositPayer", fields: [payerId], references: [id], onDelete: Cascade)
  // صاحب کارت که باید تأیید کند (مشاور / مدیر مؤسسه / سوپرادمین)
  ownerId         String
  owner           User              @relation("DepositOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // مقصد تمدید: اشتراک فردی کاربر یا اشتراک کل مؤسسه
  targetKind      DepositTargetKind
  targetId        String // userId یا instituteId
  // عکس رسید به‌صورت data URL (همان الگوی عکس پروفایل/سؤال آزمون) حداکثر ~۵۰۰KB
  receiptImageUrl String
  amount          BigInt? // مبلغ واریزی اختیاری (ریال) — برای شفافیت
  // توضیح کوتاه پرداخت‌کننده (مثل «تمدید ماهانه آبان»)
  note            String?
  status          DepositStatus     @default(PENDING)
  // مدت تمدید (روز) که فقط موقع تأیید، توسط تأییدکننده تعیین می‌شود (۱ تا ۳۶۵)
  approvedDays    Int?
  // لحظه‌ی تأیید و تاریخ پایان جدید اشتراک مقصد (برای شفافیت و گزارش)
  decidedAt       DateTime?
  newEndsAt       DateTime?
  // توضیح دلخواه تأییدکننده موقع رد (الزامی نیست)
  decisionNote    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([ownerId, status])
  @@index([payerId, status])
  @@index([targetKind, targetId])
}

// --- وضعیت انجام یک آیتم درسی در طول هفته ---
enum ItemStatus {
  PENDING
  DONE
  SKIPPED
}

// کاربر می‌تواند دانش‌آموز، مشاور یا سوپرادمین باشد
model User {
  id                String     @id @default(cuid())
  fullName          String
  email             String     @unique
  passwordHash      String
  role              UserRole   @default(STUDENT)
  status            UserStatus @default(PENDING)
  // زمان آخرین بازدید دانش‌آموز از برنامه‌اش؛ برای محاسبه‌ی «برنامه‌های تغییرکرده» استفاده می‌شود
  plansLastViewedAt DateTime?  @default(now())
  // شماره تماس کاربر؛ برای ارتباط بین مشاور و دانش‌آموز استفاده می‌شود
  // در ثبت‌نام الزامی است (در پروفایل هم قابل ویرایش)
  phone             String?
  // عکس پروفایل — به‌صورت data URL (base64) ذخیره می‌شود؛ اختیاری و حداکثر ~۵۰۰KB
  // عمداً جدا از فایل‌سیستم تا استقرار (Render) ساده بماند
  photoUrl          String?
  // توضیحات کوتاهی که کاربر (به‌ویژه مشاور) درباره‌ی خودش می‌دهد
  // برای مشاور، سوپرادمین قبل از تأیید/رد این توضیحات را می‌بیند
  // برای دانش‌آموز، می‌تواند اطلاعاتی مثل رشته، پایه، یا هدف کنکور را بنویسد
  bio               String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // عضویت اختیاری در مؤسسه — null یعنی کاربر مستقل
  instituteId   String?
  institute     Institute?  @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  // مؤسسه‌هایی که این کاربر سردبیرشان است (معمولاً حداکثر یکی)
  ledInstitutes Institute[] @relation("InstituteLeader")

  // --- رمز یکبار مصرف (OTP) برای ورود وقتی کاربر رمزش را فراموش کرده ---
  // سوپرادمین یک OTP می‌سازد و به کاربر می‌دهد. کاربر با آن وارد می‌شود و سپس پاک می‌شود.
  otpHash      String?
  otpExpiresAt DateTime?

  // --- اجبار به تغییر رمز بعد از ورود با OTP ---
  // وقتی سوپرادمین OTP می‌سازد: mustChangePassword=true می‌شود و passwordHash قبلی بی‌اعتبار می‌شود.
  // کاربر فقط با OTP می‌تواند وارد شود. بعد از تعیین رمز جدید، این فیلد false می‌شود.
  mustChangePassword Boolean @default(false)

  // --- رشته‌ی تحصیلی کاربر ---
  // برای مشاور: رشته‌ای که در آن تخصص دارد و به دانش‌آموزان آن رشته مشاوره می‌دهد
  // برای دانش‌آموز: رشته‌ی کنکوری او
  // سوپرادمین و مدیر مؤسسه معمولاً null دارند
  // در ثبت‌نام دانش‌آموز و مشاور، این فیلد انتخاب می‌شود
  field Field?

  // روابط مشاور ↔ دانش‌آموز
  asAdvisorLinks AdvisorStudentLink[] @relation("AdvisorSide")
  asStudentLinks AdvisorStudentLink[] @relation("StudentSide")

  // برنامه‌هایی که این کاربر به‌عنوان مشاور ساخته
  plansAsAdvisor StudyPlan[] @relation("PlanAdvisor")
  // برنامه‌هایی که این کاربر به‌عنوان دانش‌آموز دریافت کرده
  plansAsStudent StudyPlan[] @relation("PlanStudent")

  // تگ‌های شخصی مشاور
  tags Tag[]

  // یادآورهایی که فرستاده یا دریافت کرده
  remindersSent     Reminder[] @relation("ReminderAdvisor")
  remindersReceived Reminder[] @relation("ReminderStudent")

  // آزمون‌هایی که به‌عنوان مشاور ساخته
  examsCreated    Exam[]           @relation("ExamAdvisor")
  // آزمون‌هایی که به‌عنوان دانش‌آموز دریافت کرده
  examsAssigned   Exam[]           @relation("ExamStudent")
  // ارسال‌های آزمون دانش‌آموز
  examSubmissions ExamSubmission[] @relation("ExamSubmissionStudent")

  // توکن‌های بازنشانی رمز عبور (فراموشی رمز)
  passwordResets PasswordReset[]

  // رشته‌های تخصص مشاور (چندتا می‌تواند باشد) — فقط برای ADVISOR
  advisorFields AdvisorField[]

  // --- اشتراک و پرداخت ---
  // اشتراک فردی کاربر (مشاور مستقل / دانش‌آموز) — برای سوپرادمین ساخته نمی‌شود
  subscription      UserSubscription?
  // تنظیمات کارت واریز این کاربر (مشاور مستقل برای دانش‌آموزهایش ست می‌کند)
  // در CardSettings با ownerKind='USER' و ownerId=this.id
  // رسیدهایی که این کاربر فرستاده (پرداخت‌کننده) و رسیده‌هایی که باید تأیید کند (گیرنده)
  depositsSent      DepositRequest[]  @relation("DepositPayer")
  depositsToApprove DepositRequest[]  @relation("DepositOwner")

  @@index([instituteId])
}

// توکن‌های یک‌بار مصرف برای بازنشانی رمز عبور از طریق ایمیل
// کاربر درخواست می‌دهد → توکن ساخته می‌شود → لینک با توکن به ایمیل می‌رود
// → کاربر روی لینک کلیک می‌کند → رمز جدید را تنظیم می‌کند → توکن usedAt می‌شود
model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  // زمان انقضا — معمولاً ۱ ساعت
  expiresAt DateTime
  // زمان استفاده — null یعنی هنوز استفاده نشده
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([email])
}

// اتصال یک به چند بین مشاور و دانش‌آموز؛ دانش‌آموز فقط یک مشاور دارد
model AdvisorStudentLink {
  id                String   @id @default(cuid())
  advisorId         String
  studentId         String
  createdAt         DateTime @default(now())
  // هدف ساعت مطالعه‌ی هفتگی که مشاور برای این دانش‌آموز تعیین می‌کند (به دقیقه)
  // null یعنی هنوز هدفی تعیین نشده
  weeklyGoalMinutes Int?

  // وضعیت اتصال:
  //   PENDING  — دانش‌آموز درخواست داده، مشاور هنوز تصمیم نگرفته
  //   ACTIVE   — مشاور پذیرفته، می‌تواند برنامه/آزمون/یادآور بسازد
  //   REJECTED — مشاور رد کرده، دانش‌آموز باید مشاور دیگری انتخاب کند
  status AdvisorLinkStatus @default(PENDING)

  advisor User @relation("AdvisorSide", fields: [advisorId], references: [id], onDelete: Cascade)
  student User @relation("StudentSide", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([advisorId, studentId])
  @@index([advisorId])
  @@index([studentId])
}

// رشته‌های تحصیلی که یک مشاور در آن‌ها تخصص دارد (می‌تواند چندتا باشد)
// دانش‌آموز فقط یک رشته دارد (در User.field)؛ مشاور می‌تواند چند رشته داشته باشد.
// منطق تطابق: رشته‌ی دانش‌آموز باید در لیست رشته‌های مشاور باشد.
model AdvisorField {
  id        String   @id @default(cuid())
  userId    String
  field     Field
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, field])
  @@index([userId])
  @@index([field])
}

// تگ‌های درسی؛ یا پیش‌فرض و سراسری‌اند یا شخصی برای یک مشاور
model Tag {
  id        String  @id @default(cuid())
  name      String
  isDefault Boolean @default(false)
  advisorId String?

  advisor  User?         @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  items    PlanItemTag[]
  // لاگ‌های per-tag درون آیتم‌ها
  itemLogs PlanItemLog[]

  @@index([advisorId])
}

// برنامه‌ی مطالعاتی که مشاور برای یک دانش‌آموز می‌سازد
model StudyPlan {
  id        String    @id @default(cuid())
  title     String
  // توضیح کلی برنامه؛ اختیاری است
  note      String?
  studentId String
  advisorId String
  // بازه‌ی زمانی برنامه
  startsAt  DateTime
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student User      @relation("PlanStudent", fields: [studentId], references: [id], onDelete: Cascade)
  advisor User      @relation("PlanAdvisor", fields: [advisorId], references: [id], onDelete: Cascade)
  days    PlanDay[]

  @@index([studentId])
  @@index([advisorId])
}

// هر روز از هفته در یک برنامه؛ روز هفته ۰ تا ۶ (شنبه تا جمعه) است
model PlanDay {
  id        String @id @default(cuid())
  planId    String
  dayOfWeek Int // ۰=شنبه، ۱=یک‌شنبه، ... ۶=جمعه

  plan  StudyPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  items PlanItem[]

  @@unique([planId, dayOfWeek])
  @@index([planId])
}

// یک آیتم درسی در یک روز؛ شامل ساعت شروع و پایان است
model PlanItem {
  id          String     @id @default(cuid())
  dayId       String
  subject     String
  description String?
  // ساعت شروع و پایان این بازه‌ی درسی، با فرمت "HH:MM" (مثل "08:30")
  // به‌صورت رشته ذخیره می‌شود تا نمایش فارسی و محاسبه‌ی ساده‌تر باشد
  startTime   String?
  endTime     String?
  // ترتیب نمایش آیتم‌ها در یک روز
  order       Int        @default(0)
  status      ItemStatus @default(PENDING)

  // --- فیلدهای ثبت‌شده‌ی دانش‌آموز (روش قدیمی per-item) ---
  // زمانی که دانش‌آموز این آیتم را انجام داد، می‌تواند تعداد دقیقه‌ی واقعی و تعداد تست
  // که زده را وارد کند. این اطلاعات برای آمار دقیق‌تر از ساعت برنامه‌ریزی‌شده استفاده می‌شود.
  // null یعنی هنوز ثبت نشده.
  // نکته: در نسخه‌ی ۷، ثبت per-tag با PlanItemLog اضافه شد، اما این فیلدها هم حفظ شده‌اند
  // تا هم backward-compatible باشد و هم امکان ثبت سریع per-item را بدهد.
  actualMinutes Int? // تعداد دقیقه‌ای که واقعاً مطالعه کرده
  testsTaken    Int? // تعداد تست‌هایی که در این بازه زده

  day      PlanDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  tags     PlanItemTag[]
  // لاگ‌های per-tag که دانش‌آموز برای این آیتم ثبت کرده
  itemLogs PlanItemLog[]

  @@index([dayId])
}

// اتصال many-to-many بین آیتم و تگ
model PlanItemTag {
  id     String @id @default(cuid())
  itemId String
  tagId  String

  item PlanItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([itemId, tagId])
  @@index([itemId])
  @@index([tagId])
}

// لاگ per-tag برای یک آیتم درسی.
// دانش‌آموز برای هر تگ اختصاص‌داده‌شده به یک درس، می‌تواند زمان و تعداد تست ثبت کند.
// اگر tagId برابر null باشد یعنی «سایر کارها» — یعنی زمانی که برای این درس صرف شده
// ولی در تگ مشخصی جای نمی‌گیرد (کار اضافه روی این درس).
// testsTaken معمولاً فقط برای تگ «تمرین» در UI وارد می‌شود، اما در دیتابیس برای هر لاگ قابل ثبت است.
model PlanItemLog {
  id         String   @id @default(cuid())
  planItemId String
  // null یعنی «سایر کارها» برای این آیتم
  tagId      String?
  // تعداد دقیقه‌ای که برای این تگ/کار در این آیتم صرف شده
  minutes    Int
  // تعداد تست‌های زده‌شده (در UI فقط برای تگ «تمرین» وارد می‌شود)
  testsTaken Int?
  // توضیح اختیاری، مخصوصاً برای «سایر کارها»
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  planItem PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  tag      Tag?     @relation(fields: [tagId], references: [id], onDelete: SetNull)

  // نکته: یکتایی (planItemId, tagId) در سطح اپلیکیشن هندل می‌شود، نه در سطح دیتابیس،
  // چون tagId می‌تواند null باشد و در PostgreSQL NULL در unique constraint متمایز محسوب می‌شود.
  @@index([planItemId])
  @@index([tagId])
}

// یادآور متنی که مشاور برای دانش‌آموز می‌فرستد
model Reminder {
  id        String    @id @default(cuid())
  advisorId String
  studentId String
  message   String
  // زمان خوانده‌شدن یادآور توسط دانش‌آموز؛ null یعنی هنوز نخوانده
  readAt    DateTime?
  createdAt DateTime  @default(now())

  advisor User @relation("ReminderAdvisor", fields: [advisorId], references: [id], onDelete: Cascade)
  student User @relation("ReminderStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([advisorId])
}

// --- بخش آزمون‌ها ---

// نوع سؤال آزمون
enum QuestionType {
  MULTIPLE_CHOICE // تستی (چهارگزینه‌ای)
  DESCRIPTIVE // تشریحی
}

// وضعیت یک ارسال آزمون توسط دانش‌آموز
enum SubmissionStatus {
  IN_PROGRESS // شروع‌شده ولی هنوز ارسال نهایی نشده
  SUBMITTED // ارسال نهایی شده
  GRADED // نمره داده شده
}

// آزمونی که مشاور برای یک دانش‌آموز (یا همه‌ی دانش‌آموزهایش) می‌سازد
model Exam {
  id               String    @id @default(cuid())
  title            String
  description      String?
  studentId        String // دانش‌آموزی که آزمون برای اوست
  advisorId        String // مشاوری که آزمون را ساخته
  // روز و زمان شروع آزمون — دانش‌آموز نمی‌تواند قبل از این زمان آزمون را شروع کند
  scheduledAt      DateTime
  // مدت آزمون به دقیقه
  durationMinutes  Int
  // آیا آزمون برای دانش‌آمور نمایش داده شود؟
  // اگر false باشد، آزمون تا زمان visibleFrom مخفی است
  visibleToStudent Boolean   @default(false)
  // زمانی که آزمون برای دانش‌آموز نمایش داده می‌شود (فقط اگر visibleToStudent=false باشد)
  // اگر null باشد، از scheduledAt استفاده می‌شود (یعنی تا زمان شروع آزمون مخفی است)
  visibleFrom      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student     User             @relation("ExamStudent", fields: [studentId], references: [id], onDelete: Cascade)
  advisor     User             @relation("ExamAdvisor", fields: [advisorId], references: [id], onDelete: Cascade)
  questions   ExamQuestion[]
  submissions ExamSubmission[]

  @@index([studentId])
  @@index([advisorId])
  @@index([scheduledAt])
}

// سؤال آزمون
model ExamQuestion {
  id            String       @id @default(cuid())
  examId        String
  type          QuestionType
  // متن سؤال — اگر عکس آپلود شود، اختیاری است
  text          String?
  // برای سؤالات تستی: گزینه‌ها با | جدا می‌شوند. مثلاً "گزینه ۱|گزینه ۲|گزینه ۳|گزینه ۴"
  options       String?
  // برای سؤالات تستی: شماره گزینه‌ی صحیح (۱ تا ۴). برای تشریحی null.
  correctOption Int?
  // نمره‌ی این سؤال (مثلاً ۱ یا ۲)
  points        Int          @default(1)
  // آدرس عکس سؤال (اختیاری) — می‌تواند صورت سؤال یا ضمیمه باشد
  // عکس در کلاینت به base64 تبدیل و مستقیم در دیتابیس ذخیره می‌شود
  imageUrl      String?
  order         Int          @default(0)

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@index([examId])
}

// ارسال آزمون توسط دانش‌آموز — یک آزمون می‌تواند چند ارسال داشته باشد
// (مثلاً اگر دانش‌آموز دوباره امتحان دهد، ولی معمولاً یکی است)
model ExamSubmission {
  id          String           @id @default(cuid())
  examId      String
  studentId   String
  status      SubmissionStatus @default(IN_PROGRESS)
  // نمره‌ی کلی که مشاور داده (برای تشریحی)
  totalScore  Float?
  // حداکثر نمره‌ی ممکن
  maxScore    Float?
  // توضیح مشاور در مورد ارسال
  feedback    String?
  startedAt   DateTime         @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User         @relation("ExamSubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@index([examId])
  @@index([studentId])
}

// پاسخ دانش‌آموز به یک سؤال
model ExamAnswer {
  id             String   @id @default(cuid())
  submissionId   String
  questionId     String
  // برای تستی: شماره گزینه‌ی انتخاب‌شده (۱ تا ۴). برای تشریحی null.
  selectedOption Int?
  // برای تشریحی: متن پاسخ دانش‌آموز. برای تستی null.
  textAnswer     String?
  // نمره‌ی این پاسخ (برای تشریحی، مشاور می‌دهد؛ برای تستی، خودکار محاسبه می‌شود)
  score          Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submission ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   ExamQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@index([questionId])
}
