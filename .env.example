# ============================================================
#  نمونه‌ی تنظیمات محیطی بک‌اند — پلتفرم برنامه‌ریزی مطالعاتی کنکور
#  استفاده:  cp .env.example .env   و سپس مقادیر را جایگزین کن.
#  این فایل نباید شامل رمز یا کلید واقعی باشد.
# ============================================================


# --- دیتابیس (MySQL) — prisma/schema.prisma ---
DATABASE_URL="mysql://uqifohcg_daneshadmin:Hedman42331209@localhost:3306/uqifohcg_database"

# --- احراز هویت و JWT — src/utils/jwt.js ---
# تولید کلید تصادفی:  openssl rand -base64 48
JWT_SECRET="CHANGE_ME_openssl_rand_base64_48"
# قالب: عدد + یکی از s/m/h/d  (نمونه: 30m ، 12h ، 7d)
JWT_EXPIRES_IN="7d"

# --- سرور — src/server.js ---
# باید با target پروکسی Vite در frontend/vite.config.js هماهنگ باشد
PORT=3001

# --- محیط اجرا و لاگ — src/config/logger.js ---
# development | production | test
NODE_ENV="development"
# trace | debug | info | warn | error | fatal (خالی = خودکار)
LOG_LEVEL="warn"

# --- CORS و آدرس فرانت — src/app.js ، src/controllers/auth.controller.js ---
# چند مبدأ را با کاما جدا کن
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# آدرس پایه‌ی فرانت برای لینک بازیابی رمز عبور
FRONTEND_URL="http://localhost:5173"

# --- ایمیل (SMTP) — src/utils/mailer.js ---
# خالی بگذار تا ایمیل‌ها در توسعه فقط در لاگ چاپ شوند.
# Gmail: SMTP_PORT=587 و SMTP_PASS باید App Password باشد (نیازمند 2FA)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- سوپرادمین اولیه — prisma/seed.js ---
# اگر خالی باشند، ساخت سوپرادمین در seed رد می‌شود.
SUPERADMIN_EMAIL="admin@konkur.local"
SUPERADMIN_PASSWORD="CHANGE_ME"
